{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "rootDir": "..",
    "baseUrl": "..",
    "lib": ["ES2022", "WebWorker"],
    "paths": { "@shared/*": ["shared/*"] },
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*", "../shared/**/*"]
}
